Table "generated_report_history" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "report_title" text [not null, check: `(length(btrim(report_title)) >= 1) AND (length(btrim(report_title)) <= 120)`]
  "report_type" text [not null, check: `(length(btrim(report_type)) >= 1) AND (length(btrim(report_type)) <= 60)`]
  "period_start" date
  "period_end" date
  "file_name" text [not null, check: `file_name ~ '\.pdf$'::text`]
  "storage_path" text [unique, not null]
  "record_count" int4 [not null, check: `record_count >= 0`, default: 0]
  "prepared_by" text [not null, check: `(length(btrim(prepared_by)) >= 1) AND (length(btrim(prepared_by)) <= 180)`]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(period_start IS NULL) OR (period_end IS NULL) OR (period_end >= period_start)` [name: 'generated_report_period_check']
  }

  Indexes {
    created_at [type: btree, name: "generated_report_history_created_at_idx"]
  }
}

Table "hr_analytics_demo_records" {
  "seed_key" text [pk, not null]
  "record_type" text [not null, check: `record_type = ANY (ARRAY['employee_outlet'::text, 'attendance'::text, 'performance'::text, 'leave_request'::text, 'recruitment'::text])`]
  "employee_id" text
  "outlet" text [not null]
  "record_date" date [not null]
  "status" text
  "score" numeric(5,2) [check: `(score IS NULL) OR ((score >= (0)::numeric) AND (score <= (100)::numeric))`]
  "is_late" bool [not null, default: false]
  "is_absent" bool [not null, default: false]
  "late_minutes" int4 [not null, check: `late_minutes >= 0`, default: 0]
  "request_type" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    employee_id [type: btree, name: "hr_analytics_demo_employee_idx"]
    (record_type, record_date) [type: btree, name: "hr_analytics_demo_type_date_idx"]
  }
}

Table "job_postings" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "title" text [not null]
  "department" text
  "location" text
  "employment_type" text [default: 'Full-Time']
  "salary_range" text
  "description" text
  "qualifications" text
  "responsibilities" text
  "is_active" bool [default: true]
  "created_at" timestamptz [default: `now()`]
  "updated_at" timestamptz [default: `now()`]
}

Table "leave_types" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" text [not null, check: `(length(TRIM(BOTH FROM name)) >= 1) AND (length(TRIM(BOTH FROM name)) <= 100)`]
  "description" text [not null, check: `length(description) <= 1000`, default: '']
  "is_active" bool [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "notifications" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "recipient_role" text
  "recipient_employee_id" text
  "title" text [not null]
  "message" text [not null]
  "type" text
  "is_read" bool [default: false]
  "created_at" timestamptz [default: `now()`]
  "dedupe_key" text [unique]
}

Table "payroll_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "payroll_item_id" text [unique, not null, default: `('PAYITEM-'::text || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 10)))`]
  "payroll_id" text [not null]
  "attendance_summary_id" text
  "employee_id" text [not null]
  "employee_name" text
  "position" text
  "outlet" text
  "salary_rate" numeric(12,2) [default: 0]
  "rate_type" text [not null, check: `rate_type = ANY (ARRAY['Monthly'::text, 'Daily'::text, 'Hourly'::text])`, default: 'Monthly']
  "total_work_hours" numeric(10,2) [default: 0]
  "regular_hours" numeric(10,2) [default: 0]
  "overtime_hours" numeric(10,2) [default: 0]
  "total_late_minutes" int4 [default: 0]
  "total_undertime_minutes" int4 [default: 0]
  "total_absent_days" int4 [default: 0]
  "total_incomplete_days" int4 [default: 0]
  "basic_pay" numeric(12,2) [default: 0]
  "overtime_pay" numeric(12,2) [default: 0]
  "late_deduction" numeric(12,2) [default: 0]
  "undertime_deduction" numeric(12,2) [default: 0]
  "absence_deduction" numeric(12,2) [default: 0]
  "other_deductions" numeric(12,2) [default: 0]
  "gross_pay" numeric(12,2) [default: 0]
  "total_deductions" numeric(12,2) [default: 0]
  "net_pay" numeric(12,2) [default: 0]
  "remarks" text
  "created_at" timestamptz [default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "payslip_details" jsonb [not null, default: `'{}'::jsonb`]

  Indexes {
    employee_id [type: btree, name: "payroll_items_employee_id_idx"]
    outlet [type: btree, name: "payroll_items_outlet_idx"]
    payroll_id [type: btree, name: "payroll_items_payroll_id_idx"]
    payslip_details [type: gin, name: "payroll_items_payslip_details_gin_idx"]
  }
}

Table "payroll_premium_rates" {
  "id" int2 [pk, not null, check: `id = 1`, default: 1]
  "revision" int4 [not null, check: `revision >= 0`, default: 0]
  "nsd_percent" numeric [check: `(nsd_percent >= (0)::numeric) AND (nsd_percent < 'Infinity'::numeric)`]
  "regular_holiday_percent" numeric [check: `(regular_holiday_percent >= (0)::numeric) AND (regular_holiday_percent < 'Infinity'::numeric)`]
  "special_holiday_percent" numeric [check: `(special_holiday_percent >= (0)::numeric) AND (special_holiday_percent < 'Infinity'::numeric)`]
  "sil_percent" numeric [check: `(sil_percent >= (0)::numeric) AND (sil_percent < 'Infinity'::numeric)`]
  "holidays" jsonb [not null, check: `jsonb_typeof(holidays) = 'array'::text`, default: `'[]'::jsonb`]
}

Table "payroll_summaries" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "payroll_id" text [unique, not null, default: `('PAY-'::text || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 10)))`]
  "period_start" date [not null]
  "period_end" date [not null]
  "cutoff_label" text
  "total_employees" int4 [default: 0]
  "total_regular_hours" numeric(10,2) [default: 0]
  "total_overtime_hours" numeric(10,2) [default: 0]
  "total_late_minutes" int4 [default: 0]
  "total_undertime_minutes" int4 [default: 0]
  "total_gross_pay" numeric(12,2) [default: 0]
  "total_deductions" numeric(12,2) [default: 0]
  "total_overtime_pay" numeric(12,2) [default: 0]
  "total_net_pay" numeric(12,2) [default: 0]
  "status" text [not null, check: `status = ANY (ARRAY['Draft'::text, 'Reviewed'::text, 'Approved'::text, 'Endorsed'::text, 'Exported'::text])`, default: 'Draft']
  "prepared_by_user_id" text
  "reviewed_by_user_id" text
  "reviewed_at" timestamptz
  "endorsed_to" text [default: 'Accounting and Finance Personnel']
  "endorsed_at" timestamptz
  "remarks" text
  "created_at" timestamptz [default: `now()`]
  "updated_at" timestamptz [default: `now()`]

  Checks {
    `period_end >= period_start` [name: 'payroll_summaries_period_check']
  }

  Indexes {
    (period_start, period_end) [type: btree, unique, name: "payroll_summaries_unique_period"]
    period_end [type: btree, name: "payroll_summaries_period_end_idx"]
    period_start [type: btree, name: "payroll_summaries_period_start_idx"]
    status [type: btree, name: "payroll_summaries_status_idx"]
  }
}

Table "schedule_swap_requests" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "request_id" text [unique, not null, default: `('SWAP-'::text || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 10)))`]
  "requester_employee_id" text [not null]
  "recipient_employee_id" text [not null]
  "requester_schedule_id" text [not null]
  "recipient_schedule_id" text [not null]
  "swap_day" text [not null, check: `swap_day = ANY (ARRAY['monday'::text, 'tuesday'::text, 'wednesday'::text, 'thursday'::text, 'friday'::text, 'saturday'::text, 'sunday'::text])`]
  "week" text [not null]
  "requester_outlet" text
  "recipient_outlet" text
  "requester_shift" text [not null]
  "recipient_shift" text [not null]
  "reason" text [not null, default: '']
  "status" text [not null, check: `status = ANY (ARRAY['Pending Coworker'::text, 'Pending HR'::text, 'Approved'::text, 'Rejected'::text, 'Cancelled'::text])`, default: 'Pending Coworker']
  "recipient_accepted" bool
  "recipient_note" text
  "recipient_responded_at" timestamptz
  "hr_user_id" uuid
  "hr_note" text
  "hr_reviewed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `requester_employee_id <> recipient_employee_id` [name: 'schedule_swap_distinct_employees']
    `requester_schedule_id <> recipient_schedule_id` [name: 'schedule_swap_distinct_schedules']
  }

  Indexes {
    (recipient_employee_id, status) [type: btree, name: "schedule_swap_recipient_status_idx"]
    (requester_employee_id, status) [type: btree, name: "schedule_swap_requester_status_idx"]
  }
}

Table "system_logs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "log_id" text [unique, not null, default: `('LOG-'::text || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 10)))`]
  "user_id" text
  "user_name" text
  "user_role" text
  "action" text [not null]
  "module" text [not null]
  "record_id" text
  "record_table" text
  "description" text
  "old_data" jsonb
  "new_data" jsonb
  "ip_address" text
  "user_agent" text
  "created_at" timestamptz [default: `now()`]

  Indexes {
    action [type: btree, name: "system_logs_action_idx"]
    created_at [type: btree, name: "system_logs_created_at_idx"]
    module [type: btree, name: "system_logs_module_idx"]
    record_table [type: btree, name: "system_logs_record_table_idx"]
    user_id [type: btree, name: "system_logs_user_id_idx"]
    user_role [type: btree, name: "system_logs_user_role_idx"]
  }
}

Table "user_accounts" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "applicant_id" text [unique]
  "first_name" text
  "middle_name" text
  "last_name" text
  "full_name" text
  "email" text [unique]
  "password" text
  "role" text [check: `role = ANY (ARRAY['hr_admin'::text, 'general_manager'::text, 'accounting_finance'::text, 'supervisor'::text, 'employee'::text])`, default: 'employee']
  "outlet" text
  "is_active" bool [default: true]
  "created_at" timestamptz [default: `now()`]
  "user_id" text [unique]
  "employee_id" text [unique]
  "suffix" text
  "auth_user_id" uuid [unique]
}

